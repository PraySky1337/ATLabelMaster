        </property>
        <property name="styleSheet">
         <string notr="true">color: #9ece6a; font-size: 10px;</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Label Format / Batch Convert Section -->
