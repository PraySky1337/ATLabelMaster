<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DatasetDialog</class>
 <widget class="QDialog" name="DatasetDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>450</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>数据集管理</string>
